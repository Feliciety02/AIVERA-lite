# Copy this file to server/.env and fill it in. server/.env is never committed.

DATABASE_URL="file:./dev.db"
PORT=4100

# Websites the app may scan (comma separated host names). Only add sites you have
# written permission to test. Leave empty to allow any host (not recommended).
ALLOWED_HOSTS="127.0.0.1,localhost,umerch3-0-r74e.onrender.com"

# AI provider (any OpenAI-compatible chat API).
# Default: Ollama on this computer, so nothing leaves the machine.
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_MODEL="llama3.2:3b"
AI_API_KEY=""
# Groq free tier instead (data is redacted before it is sent):
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="openai/gpt-oss-120b"
# AI_API_KEY="your key, only in this file"

# Security tools. Leave empty if the tool is on PATH.
NMAP_PATH="C:/Program Files (x86)/Nmap/nmap.exe"
# ZAP install folder (the one that contains zap-<version>.jar).
ZAP_PATH="C:/Program Files/ZAP/Zed Attack Proxy"
# Java for ZAP. Leave empty to use the Java bundled with ZAP or on PATH.
JAVA_PATH=""
